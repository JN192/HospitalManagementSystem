{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "^/(config|controllers|models|views|database|reports|\\.git)(/.*)?$", "status": 404 },
    { "src": "^/(test_connection\\.php|share_router\\.php|.*\\.sql)$", "status": 404 },
    { "src": "^/(index\\.php)?$", "dest": "/api/index.php" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}